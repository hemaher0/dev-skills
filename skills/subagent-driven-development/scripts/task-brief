#!/usr/bin/env bash
# Extract one task's full text from an implementation plan into a file the
# implementer reads in one call, so the task text never has to be pasted
# through the controller's context.
#
# Usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]
# Default OUTFILE: <repo-root>/.kryptonite/sdd/<plan-basename>/task-<N>-brief.md
# (per plan and per worktree; concurrent runs of the SAME plan in the same
# working tree share it).
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]" >&2
  exit 2
fi

plan=$1
n=$2
[[ "$n" =~ ^[1-9][0-9]*$ ]] \
  || { echo "task number must be a positive integer: $n" >&2; exit 2; }
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

if [ $# -eq 3 ]; then
  out=$3
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/task-${n}-brief.md"
fi

[ ! -d "$out" ] || { echo "output is a directory: $out" >&2; exit 2; }

# Publish only a complete extraction. Keep the temporary file on the same
# filesystem so a failed lookup cannot truncate an earlier enriched brief.
tmp=$(mktemp "$(dirname "$out")/.task-brief.XXXXXX")
trap 'rm -f -- "$tmp"' EXIT

awk -v n="$n" '
  {
    line = $0
    sub(/^ ? ? ?/, "", line)
    if (infence) {
      if (substr(line, 1, 1) == fencechar) {
        run = line
        if (fencechar == "`") sub(/[^`].*$/, "", run)
        else sub(/[^~].*$/, "", run)
        tail = substr(line, length(run) + 1)
        if (length(run) >= fencesize && tail ~ /^[ \t]*$/) infence = 0
      }
    } else if (line ~ /^```/ || line ~ /^~~~/) {
      fencechar = substr(line, 1, 1)
      run = line
      if (fencechar == "`") sub(/[^`].*$/, "", run)
      else sub(/[^~].*$/, "", run)
      tail = substr(line, length(run) + 1)
      if (fencechar == "~" || tail !~ /`/) {
        fencesize = length(run)
        infence = 1
      }
    } else if (line ~ /^#+[ \t]+Task[ \t]+[0-9]+/) {
      intask = (line ~ ("^#+[ \t]+Task[ \t]+" n "([^0-9]|$)"))
    }
    if (intask) print
  }
' "$plan" > "$tmp"

if [ ! -s "$tmp" ]; then
  echo "task ${n} not found in ${plan} (no heading matching 'Task ${n}')" >&2
  exit 3
fi

mv -- "$tmp" "$out"
echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
