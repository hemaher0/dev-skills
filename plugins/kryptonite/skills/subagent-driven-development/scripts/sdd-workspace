#!/usr/bin/env bash
# Resolve and ensure the working-tree directory SDD uses for one plan's
# short-lived artifacts: task briefs, implementer reports, review packages,
# and the progress ledger. Print the plan directory's absolute path.
#
# One directory per normalized plan path (.kryptonite/sdd/<plan-id>/).
# Different plans may use the same filename. Content revisions retain the
# same workspace; the controller checks the recorded revision on recovery.
#
# The workspace lives in the working tree, outside Git metadata, so
# implementer subagents can write their report files. A self-ignoring
# .gitignore at .kryptonite/sdd/ keeps every plan's workspace out of
# `git status` and out of accidental commits without modifying any tracked file.
#
# Single source of truth for the workspace location, so task-brief and
# review-package cannot drift to different directories.
#
# Usage: sdd-workspace PLAN_FILE
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: sdd-workspace PLAN_FILE" >&2
  exit 2
fi

plan=$1
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

root=$(git rev-parse --show-toplevel)
plan_dir=$(cd -- "$(dirname -- "$plan")" && pwd -P)
plan_path="$plan_dir/$(basename -- "$plan")"
case "$plan_path" in
  "$root"/*) plan_key=${plan_path#"$root"/} ;;
  *) plan_key=$plan_path ;;
esac
# Hash the path identity, not the contents. Without -w, Git writes no object.
plan_id=$(printf '%s\n' "$plan_key" | git hash-object --stdin)
base="$root/.kryptonite/sdd"
dir="$base/$plan_id"
legacy="$base/$(basename -- "$plan" .md)"
if [ ! -e "$dir" ] && [ -e "$legacy" ]; then
  echo "existing filename-based workspace: $legacy" >&2
  echo "verify its owner and progress before continuing; reuse verified records with explicit helper OUTFILE paths, or explicitly migrate them to $dir" >&2
  exit 3
fi
mkdir -p "$dir"
printf '*\n' > "$base/.gitignore"
cd "$dir" && pwd
